---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { sitePath } from '../lib/paths';
import '../styles/global.css';
import '../styles/glass.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = 'Multimodal Intelligence Lab',
  description = 'Multimodal Intelligence Lab at the University of Exeter.',
  currentPath = '/'
} = Astro.props;
const pageTitle = title === 'Multimodal Intelligence Lab' ? title : `${title} · Multimodal Intelligence Lab`;
// Chromium browsers prerender a page as soon as the pointer rests on its link, so the
// click shows it instantly; the header links are also prefetched once each page is idle.
const speculationRules = JSON.stringify({
  prerender: [{
    where: { and: [{ href_matches: sitePath('*') }, { not: { href_matches: sitePath('admin/*') } }] },
    eagerness: 'moderate'
  }]
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#edf7fc" />
    <link rel="icon" type="image/svg+xml" href={sitePath('favicon.svg')} />
    <title>{pageTitle}</title>
    <script type="speculationrules" is:inline set:html={speculationRules} />
  </head>
  <body>
    <div class="liquid-scene" aria-hidden="true"><span></span><span></span></div>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header currentPath={currentPath} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      const menuButton = document.querySelector('[data-menu-button]');
      const menu = document.querySelector('[data-menu]');
      menuButton?.addEventListener('click', () => {
        const expanded = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!expanded));
        menu?.toggleAttribute('data-open', !expanded);
      });
    </script>
    <script>
      import { mountLiquidGlass } from '../lib/liquid-glass';
      mountLiquidGlass();
    </script>
  </body>
</html>
