---
import BaseLayout from '../layouts/BaseLayout.astro';
import SignalField from '../components/SignalField.astro';
import MultimodalVisual from '../components/MultimodalVisual.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import site from '../data/site.json';
import { sitePath } from '../lib/paths';
import { getCollection, render } from 'astro:content';

const researchInterests = [
  'Video analysis',
  'Multimedia Computing',
  'Machine learning',
  'Medical image/video analysis',
  'Satellite and drone imagery analysis',
  'AI for Science'
];
const funders = [
  { logo: 'the_alan_turing_institute_logo.jpeg', name: 'The Alan Turing Institute' },
  { logo: 'exeter.png', name: 'University of Exeter' },
  { logo: 'dso_singapore_log.png', name: 'DSO National Laboratories' },
  { logo: 'ukri_logo.png', name: 'UKRI Research England' }
];
const collaborators = [
  { logo: 'newcastle-uni.png', name: 'Newcastle University' },
  { logo: 'birmingham-uni.jpeg', name: 'University of Birmingham' },
  { logo: 'univ-liverpool.png', name: 'University of Liverpool' }
];
const newsEntries = (await getCollection('news'))
  .filter((item) => !item.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const news = await Promise.all(newsEntries.map(async (entry) => ({ entry, content: await render(entry) })));
---

<BaseLayout title={site.name} description={site.description} currentPath="/">
  <section class="hero">
    <SignalField />
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> University of Exeter · Computer Science</p>
        <h1 class="hero-title">Multimodal<br />Intelligence Lab</h1>
        <p class="hero-intro">Welcome to the Multimodal Intelligence Lab, where we explore innovative solutions at the intersection of Artificial Intelligence, Machine Learning, and Multimodal Data Processing. Aligned with the University of Exeter’s 2030 strategy, our research investigates how <strong>Multimodal AI</strong> and related disciplines can contribute to a greener, healthier, and fairer society. Our core focus is the development of computer vision and machine learning techniques, with applications in healthcare, the environment, and social science.</p>
        <div class="hero-actions">
          <a class="button button-primary" href={sitePath('research/')}>Explore our research</a>
          <a class="text-link" href={sitePath('publications/')}>View publications <svg class="link-arrow" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12 12 4M4 4h8v8" /></svg></a>
        </div>
      </div>
      <MultimodalVisual />
    </div>
  </section>

  <section class="section research-overview">
    <div class="shell">
      <h2 class="research-heading">Research interests</h2>
      <div class="research-grid">
        {researchInterests.map((title) => (
          <a class="research-tile" href={sitePath('research/')}>
            <h3>{title}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section latest-section" id="news">
    <div class="shell">
      <div class="section-heading inline-heading">
        <div><p class="eyebrow">Lab updates</p><h2>News</h2></div>
        <p class="news-window-count">{news.length} updates · scroll to explore</p>
      </div>
      <div class="home-news-window">
        <div class="home-news-toolbar" aria-hidden="true"><span></span><span></span><span></span><small>All lab updates</small></div>
        <div class="home-news-scroll" tabindex="0" aria-label="All lab news, scrollable">
          {news.map(({ entry, content: { Content } }) => (
            <article class="home-news-entry" id={`news-${entry.id}`}>
              <div class="home-news-date">
                <strong>{entry.data.dateLabel || entry.data.date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })}</strong>
                <span>{entry.data.category}</span>
              </div>
              <div class="home-news-copy">
                <div class="prose news-prose"><Content /></div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section partners-section">
    <div class="shell">
      <div class="partner-group">
        <h2>Selected Funders</h2>
        <p>The research works at MIL has gratefully received funding from several distinguished and venerable funders.</p>
        <div class="partner-logos funder-logos">
          {funders.map(({ logo, name }) => (
            <div class="partner-logo"><OptimizedImage src={`assets/logos/${logo}`} alt={name} width={640} widths={[320, 640]} sizes="(max-width: 600px) 45vw, (max-width: 900px) 260px, 320px" quality={90} loading="eager" /></div>
          ))}
        </div>
      </div>
      <div class="partner-group">
        <h2>Selected Collaborators</h2>
        <p>The lab is fortunate to collaborate with a range of internal and external partners.</p>
        <div class="partner-logos collaborator-logos">
          {collaborators.map(({ logo, name }) => (
            <div class="partner-logo"><OptimizedImage src={`assets/logos/${logo}`} alt={name} width={540} widths={[270, 540]} sizes="(max-width: 600px) 45vw, 300px" quality={90} loading="eager" /></div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
