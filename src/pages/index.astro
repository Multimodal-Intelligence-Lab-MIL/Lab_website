---
import '../styles/home.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import SignalField from '../components/SignalField.astro';
import MultimodalVisual from '../components/MultimodalVisual.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import site from '../data/site.json';
import { sitePath } from '../lib/paths';
import { getCollection, render } from 'astro:content';
import { localImage } from '../lib/media';
import { getResearchAreas, researchAreaPath } from '../lib/research';
import { accentColor } from '../lib/accents';

const researchAreas = await getResearchAreas();
// Rows of three: independent funders first, then the three UKRI councils together.
const funders = [
  { logo: 'alan-turing-institute.png', name: 'The Alan Turing Institute' },
  { logo: 'university-of-exeter.png', name: 'University of Exeter' },
  { logo: 'dso-national-laboratories.png', name: 'DSO National Laboratories' },
  { logo: 'ukri-research-england.png', name: 'UKRI Research England', scale: 1.5 },
  { logo: 'ukri-epsrc.png', name: 'UKRI Engineering and Physical Sciences Research Council', scale: 1.5 },
  { logo: 'ukri-innovate-uk.png', name: 'UKRI Innovate UK', scale: 1.5 }
];
const collaborators = [
  { logo: 'newcastle-university.png', name: 'Newcastle University' },
  { logo: 'university-of-birmingham.png', name: 'University of Birmingham' },
  { logo: 'university-of-liverpool.png', name: 'University of Liverpool' },
  { logo: 'durham-university.png', name: 'Durham University' },
  { logo: 'sutd.png', name: 'Singapore University of Technology and Design' }
];
// Give every logo a similar visual area instead of the same box, so wide
// wordmarks and tall crests read with equal weight (logos come from scripts/prepare-logos.mjs).
// `scale` enlarges marks whose small type would otherwise be hard to read.
const sizeLogos = (logos: { logo: string; name: string; scale?: number }[]) => Promise.all(logos.map(async ({ scale = 1, ...item }) => {
  const source = await localImage(`assets/logos/clean/${item.logo}`);
  const aspect = source ? source.width / source.height : 2;
  const height = Math.min(scale > 1 ? 118 : 104, Math.sqrt(9600 * scale / aspect));
  return { ...item, src: `assets/logos/clean/${item.logo}`, height: Math.round(height), width: Math.round(height * aspect) };
}));
const partnerGroups = [
  { title: 'Selected Funders', intro: 'The research works at MIL has gratefully received funding from several distinguished and venerable funders.', logos: await sizeLogos(funders) },
  { title: 'Selected Collaborators', intro: 'The lab is fortunate to collaborate with a range of internal and external partners.', logos: await sizeLogos(collaborators) }
];
const newsEntries = (await getCollection('news'))
  .filter((item) => !item.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const news = await Promise.all(newsEntries.map(async (entry) => ({ entry, content: await render(entry) })));
---

<BaseLayout title={site.name} description={site.description} currentPath="/">
  <section class="hero">
    <SignalField />
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> University of Exeter · Computer Science</p>
        <h1 class="hero-title">Multimodal<br />Intelligence Lab</h1>
        <p class="hero-intro">Welcome to the Multimodal Intelligence Lab, where we explore innovative solutions at the intersection of Artificial Intelligence, Machine Learning, and Multimodal Data Processing. Aligned with the University of Exeter’s 2030 strategy, our research investigates how <strong>Multimodal AI</strong> and related disciplines can contribute to a greener, healthier, and fairer society. Our core focus is the development of computer vision and machine learning techniques, with applications in healthcare, the environment, and social science.</p>
        <div class="hero-actions">
          <a class="button button-primary" data-glass="control" href={sitePath('research/')}>Explore our research</a>
          <a class="text-link" href={sitePath('publications/')}>View publications <svg class="link-arrow" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12 12 4M4 4h8v8" /></svg></a>
        </div>
      </div>
      <MultimodalVisual />
    </div>
  </section>

  <section class="section research-overview">
    <div class="shell">
      <h2 class="research-heading">Research interests</h2>
      <div class="research-grid">
        {researchAreas.map(({ area, papers }) => (
          <div class="research-item" style={`--area-accent: ${accentColor(area.data.accent)}`}>
            <a class="research-tile" data-glass="panel" href={researchAreaPath(area.id)} aria-describedby={`area-summary-${area.id}`}>
              <h3>{area.data.title}</h3>
              <p class="research-tile-summary" aria-hidden="true">{area.data.summary}</p>
              <span class="research-tile-count">{papers.length} publications</span>
            </a>
            {/* A sibling of the tile, not a child: a glass pane isolates the backdrop of
                anything inside it, so a larger popover nested in it would blur nothing. */}
            <div class="research-pop" data-glass="float">
              <p class="research-pop-title">{area.data.title}</p>
              <p id={`area-summary-${area.id}`}>{area.data.summary}</p>
              <span class="research-pop-more">{papers.length} publications · Explore <span aria-hidden="true">→</span></span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section latest-section" id="news">
    <div class="shell">
      <div class="section-heading inline-heading">
        <div><p class="eyebrow">Lab updates</p><h2>News</h2></div>
        <p class="news-window-count">{news.length} updates · scroll to explore</p>
      </div>
      <div class="home-news-window" data-glass="sheet">
        <div class="home-news-toolbar" aria-hidden="true"><span></span><span></span><span></span><small>All lab updates</small></div>
        <div class="home-news-scroll" tabindex="0" aria-label="All lab news, scrollable">
          {news.map(({ entry, content: { Content } }) => (
            <article class="home-news-entry" id={`news-${entry.id}`}>
              <div class="home-news-date">
                <strong>{entry.data.dateLabel || entry.data.date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })}</strong>
                <span>{entry.data.category}</span>
              </div>
              <div class="home-news-copy">
                <div class="prose news-prose"><Content /></div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section partners-section">
    <div class="shell">
      {partnerGroups.map(({ title, intro, logos }) => (
        <div class="partner-group">
          <h2>{title}</h2>
          <p>{intro}</p>
          <ul class="partner-logos" role="list">
            {logos.map(({ src, name, width, height }) => (
              <li class="partner-logo" data-glass="panel" style={`--logo-w: ${width}px; --logo-h: ${height}px`}>
                <OptimizedImage src={src} alt={name} width={width * 2} widths={[width, width * 2]} sizes={`${width}px`} quality={90} />
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
