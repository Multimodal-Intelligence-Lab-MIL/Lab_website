---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sitePath } from '../lib/paths';
---
<BaseLayout title="Page not found">
  <section class="not-found"><div class="shell"><p class="eyebrow"><span></span>Error 404</p><h1>Signal not found.</h1><p>The page may have moved or is no longer available.</p><a class="button button-primary" href={sitePath()}>Return home</a></div></section>
</BaseLayout>
