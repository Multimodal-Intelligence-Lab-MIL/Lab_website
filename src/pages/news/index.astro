---
import '../../styles/news.css';
import { sitePath } from '../../lib/paths';

const homeUrl = sitePath('');
const newsUrl = sitePath('#news');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${newsUrl}`} />
    <link rel="canonical" href={newsUrl} />
    <title>News · Multimodal Intelligence Lab</title>
  </head>
  <body>
    <p>News now lives on the <a href={newsUrl}>home page</a>.</p>
    <script is:inline define:vars={{ homeUrl, newsUrl }}>
      const legacyId = window.location.hash.replace(/^#/, '');
      window.location.replace(legacyId ? `${homeUrl}#news-${legacyId}` : newsUrl);
    </script>
  </body>
</html>
