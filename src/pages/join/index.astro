---
import BaseLayout from '../../layouts/BaseLayout.astro';
import joinData from '../../data/join.json';
import site from '../../data/site.json';
---

<BaseLayout title="Join us" description="Opportunities to join the Multimodal Intelligence Lab." currentPath="/join/">
  <section class="join-hero">
    <div class="shell join-hero-inner">
      <p class="join-kicker">{joinData.eyebrow}</p>
      <h1>{joinData.title}</h1>
      <p class="join-lead">{joinData.intro}</p>
    </div>
  </section>

  <section class="join-programme" aria-labelledby="phd-opportunities">
    <div class="shell">
      <header class="join-programme-heading">
        <p class="join-kicker">{joinData.phd.eyebrow}</p>
        <h2 id="phd-opportunities">{joinData.phd.title}</h2>
        <p>{joinData.phd.intro}</p>
      </header>
      <div class="join-opportunity-list">
        {joinData.phd.opportunities.map((opportunity, index) => (
          <article class="join-opportunity">
            <span class="join-opportunity-index">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>
                {opportunity.url ? (
                  <a href={opportunity.url} target="_blank" rel="noreferrer">{opportunity.title}</a>
                ) : opportunity.title}
              </h3>
              {opportunity.note && <p>{opportunity.note}</p>}
            </div>
            {opportunity.url && <span class="join-opportunity-arrow" aria-hidden="true">↗</span>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="join-programme join-programme-muted" aria-labelledby="postdoc-opportunities">
    <div class="shell">
      <header class="join-programme-heading">
        <p class="join-kicker">{joinData.postdoc.eyebrow}</p>
        <h2 id="postdoc-opportunities">{joinData.postdoc.title}</h2>
        <p>{joinData.postdoc.intro}</p>
      </header>
      <div class="join-opportunity-list">
        {joinData.postdoc.opportunities.map((opportunity, index) => (
          <article class="join-opportunity">
            <span class="join-opportunity-index">{String(index + 1).padStart(2, '0')}</span>
            <div><h3><a href={opportunity.url} target="_blank" rel="noreferrer">{opportunity.title}</a></h3></div>
            <span class="join-opportunity-arrow" aria-hidden="true">↗</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="join-contact-panel">
    <div class="shell join-contact-inner">
      <p class="join-kicker">{joinData.contact.eyebrow}</p>
      <h2>{joinData.contact.title}</h2>
      <p>{joinData.contact.body}</p>
      <a class="join-contact-button" href={`mailto:${site.email}`}>{joinData.contact.buttonLabel}<span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
