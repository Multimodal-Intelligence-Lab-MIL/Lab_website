---
import { getCollection } from 'astro:content';
import { sitePath } from '../../lib/paths';

const repositoryUrl = 'https://github.com/Multimodal-Intelligence-Lab-MIL/Lab_website';
const repositorySlug = 'Multimodal-Intelligence-Lab-MIL/Lab_website';
const branch = 'main';
const contentFile = (id: string) => id.endsWith('.md') ? id : `${id}.md`;
const editUrl = (folder: string, id: string) => `${repositoryUrl}/edit/${branch}/${folder}/${contentFile(id)}`;

const serialiseData = (data: Record<string, unknown>) => Object.fromEntries(
  Object.entries(data).map(([key, value]) => [
    key,
    value instanceof Date ? value.toISOString().slice(0, 10) : value
  ])
);
const markdownExcerpt = (value: string) => value
  .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
  .replace(/[*_`>#]/g, '')
  .replace(/\s+/g, ' ')
  .trim()
  .slice(0, 96);

const newsEntries = (await getCollection('news'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((item) => ({
    id: item.id,
    title: markdownExcerpt(item.body || '') || `News · ${item.data.date.toLocaleDateString('en-GB')}`,
    meta: `${item.data.date.toLocaleDateString('en-GB')} · ${item.data.category}`,
    path: `src/content/news/${contentFile(item.id)}`,
    url: editUrl('src/content/news', item.id),
    data: serialiseData(item.data),
    body: item.body || ''
  }));

const publicationEntries = (await getCollection('publications'))
  .sort((a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title))
  .map((item) => ({
    id: item.id,
    title: item.data.title,
    meta: `${item.data.year} · ${item.data.category}`,
    path: `src/content/publications/${contentFile(item.id)}`,
    url: editUrl('src/content/publications', item.id),
    data: serialiseData(item.data),
    body: item.body || ''
  }));

const peopleEntries = (await getCollection('people'))
  .sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name))
  .map((item) => ({
    id: item.id,
    title: item.data.name,
    meta: item.data.category,
    path: `src/content/people/${contentFile(item.id)}`,
    url: editUrl('src/content/people', item.id),
    data: serialiseData(item.data),
    body: item.body || ''
  }));

const researchEntries = (await getCollection('research'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((item) => ({
    id: item.id,
    title: item.data.title,
    meta: item.data.shortTitle,
    path: `src/content/research/${contentFile(item.id)}`,
    url: editUrl('src/content/research', item.id),
    data: serialiseData(item.data),
    body: item.body || ''
  }));

const panels = [
  { key: 'news', label: 'Lab news', items: newsEntries },
  { key: 'publications', label: 'Publications', items: publicationEntries },
  { key: 'people', label: 'People', items: peopleEntries },
  { key: 'research', label: 'Research', items: researchEntries }
];

const currentPublicationImages = publicationEntries
  .map((entry) => String(entry.data.image || ''))
  .filter(Boolean);
const currentPeopleImages = peopleEntries
  .map((entry) => String(entry.data.image || ''))
  .filter(Boolean);
const initialMedia = {
  publications: [...new Set(currentPublicationImages)].sort(),
  people: [...new Set(currentPeopleImages)].sort()
};

const adminData = {
  repositoryUrl,
  repositorySlug,
  branch,
  content: {
    news: newsEntries,
    publications: publicationEntries,
    people: peopleEntries,
    research: researchEntries
  },
  initialMedia,
  siteBase: sitePath('')
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f7fbfd" />
    <title>MIL Admin Gateway</title>
    <link rel="stylesheet" href="admin.css" />
  </head>
  <body>
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>
    <div class="signal-grid" aria-hidden="true"></div>

    <section class="login-view" data-login-view>
      <div class="login-card">
        <a class="brand" href={sitePath('')}>
          <span class="brand-mark">M</span>
          <span><strong>MIL</strong><small>Content gateway</small></span>
        </a>
        <p class="eyebrow">Private editing entrance</p>
        <h1>Manage the lab website.</h1>
        <p class="login-copy">Sign in to prepare repository changes. GitHub will verify write access and handle every commit.</p>
        <form data-login-form autocomplete="off">
          <label>
            <span>Username</span>
            <input name="username" type="text" autocomplete="off" required autofocus />
          </label>
          <label>
            <span>Password</span>
            <input name="password" type="password" autocomplete="off" required />
          </label>
          <p class="form-error" data-login-error role="alert" hidden>Incorrect username or password.</p>
          <button class="primary-button" type="submit">Enter admin</button>
        </form>
        <p class="security-note">This is a lightweight visual gate. Repository write access is still controlled by your existing GitHub account.</p>
      </div>
    </section>

    <div class="admin-view" data-admin-view hidden>
      <header class="admin-header">
        <a class="brand" href={sitePath('')}>
          <span class="brand-mark">M</span>
          <span><strong>MIL</strong><small>Website administration</small></span>
        </a>
        <div class="header-actions">
          <a href={sitePath('')} target="_blank" rel="noreferrer">View website</a>
          <a href={`${repositoryUrl}/actions`} target="_blank" rel="noreferrer">Deploy status</a>
          <button type="button" data-logout>Log out</button>
        </div>
      </header>

      <main class="admin-shell">
        <section class="admin-intro">
          <div>
            <p class="eyebrow">Git-backed content management</p>
            <h1>Prepare here.<br /><em>Commit on GitHub.</em></h1>
          </div>
          <p>Choose the content and operation first. The gateway will prepare the correct media folder, fields and repository path without introducing another service or account.</p>
        </section>

        <section class="workflow" aria-label="Content editing workflow">
          <article class="workflow-card workflow-selection">
            <span class="step-number">01</span>
            <div>
              <p class="card-label">Choose the change</p>
              <h2>Select content and operation</h2>
              <form data-selection-form>
                <label>
                  <span>Content type</span>
                  <select name="contentType" required>
                    <option value="">Please select</option>
                    <option value="news">Lab news</option>
                    <option value="publications">Publication</option>
                    <option value="people">Lab member</option>
                    <option value="research">Research theme</option>
                  </select>
                </label>
                <label>
                  <span>Operation</span>
                  <select name="operation" disabled required>
                    <option value="">Please select</option>
                    <option value="create">Create a new entry</option>
                    <option value="edit">Edit an existing entry</option>
                    <option value="delete">Delete an existing entry</option>
                  </select>
                </label>
                <label data-entry-field hidden>
                  <span>Existing entry</span>
                  <select name="entryId">
                    <option value="">Please select</option>
                  </select>
                </label>
                <p class="create-status" data-selection-status aria-live="polite">Please select a content type first.</p>
              </form>
            </div>
          </article>

          <article class="workflow-card workflow-publication-reference" data-news-reference hidden>
            <span class="step-number">REF</span>
            <div>
              <p class="card-label">Publication URL reference</p>
              <h2>Link to a paper on this website</h2>
              <p>Publications are listed newest first. Copy the relative URL and place it inside a Markdown link in the News editor.</p>
              <div class="publication-reference-list">
                {publicationEntries.map((publication) => {
                  const relativeUrl = `publications/${publication.id}/`;
                  return (
                    <div class="publication-reference-row">
                      <span>{publication.data.year}</span>
                      <div>
                        <a href={sitePath(relativeUrl)} target="_blank" rel="noreferrer">{publication.title}</a>
                        <code>{relativeUrl}</code>
                      </div>
                      <button type="button" data-copy-publication-url={relativeUrl}>Copy URL</button>
                    </div>
                  );
                })}
              </div>
              <p class="create-status" data-publication-copy-status aria-live="polite"></p>
            </div>
          </article>

          <article class="workflow-card workflow-media" data-media-step aria-disabled="true">
            <span class="step-number">02</span>
            <div>
              <p class="card-label">Media</p>
              <h2>Upload or delete images</h2>
              <div class="step-locked" data-media-locked>Please select the first step before managing images.</div>
              <div data-media-controls hidden>
                <p>GitHub will open the matching upload folder. Commit the image there, return to this page, and refresh the list before choosing it in the content form.</p>
                <p class="repository-path" data-media-path></p>
                <div class="button-row">
                  <a class="outline-button" data-upload-link target="_blank" rel="noreferrer">Open GitHub uploader</a>
                  <button class="outline-button" type="button" data-refresh-media>Refresh image list</button>
                </div>
                <p class="create-status" data-media-status aria-live="polite"></p>
                <div class="media-list" data-media-list></div>
              </div>
            </div>
          </article>

          <article class="workflow-card workflow-editor" data-editor-step aria-disabled="true">
            <span class="step-number" data-editor-step-number>03</span>
            <div>
              <p class="card-label">Content file</p>
              <h2 data-editor-title>Complete the fields</h2>
              <div class="step-locked" data-editor-locked>Please select the first step before editing content.</div>

              <div data-content-editor hidden>
                <div class="paste-guide">
                  <strong>Final GitHub steps</strong>
                  <ol>
                    <li>Complete every required field below.</li>
                    <li>Click <strong>Copy complete file content</strong>.</li>
                    <li>Click <strong>Open GitHub editor</strong>.</li>
                    <li>Paste into the large <strong>file editing area</strong> on GitHub — not the commit message box.</li>
                    <li>Click <strong>Commit changes</strong> on GitHub.</li>
                  </ol>
                </div>
                <form data-content-form>
                  <div class="field-grid" data-content-fields></div>
                  <label class="slug-field" data-slug-field>
                    <span>Generated file name</span>
                    <div class="slug-control"><input name="slug" type="text" required /><b>.md</b></div>
                    <small>Generated from the title for new entries. You can correct it before copying.</small>
                  </label>
                  <p class="repository-path" data-content-path></p>
                  <div class="button-row final-actions">
                    <button class="primary-button" type="button" data-copy-content>1. Copy complete file content</button>
                    <button class="outline-button" type="button" data-open-github disabled>2. Open GitHub editor</button>
                  </div>
                  <p class="create-status" data-content-status aria-live="polite"></p>
                </form>
              </div>

              <div data-delete-panel hidden>
                <p>This opens GitHub's delete page for the selected source file. Review the file once more, then commit the deletion on GitHub.</p>
                <p class="repository-path" data-delete-path></p>
                <a class="primary-button" data-delete-link target="_blank" rel="noreferrer">Open GitHub delete page</a>
              </div>
            </div>
          </article>
        </section>

        <section class="library-section">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Content library</p>
              <h2>Load an existing entry</h2>
            </div>
            <p>Select an entry to load it into the workflow above. You can then edit its structured fields or switch the operation to delete.</p>
          </div>

          <div class="content-tabs" role="tablist" aria-label="Content types">
            {panels.map((panel, index) => (
              <button type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-tab={panel.key}>
                {panel.label}<span>{panel.items.length}</span>
              </button>
            ))}
          </div>

          {panels.map((panel, index) => (
            <div class="content-panel" role="tabpanel" data-panel={panel.key} hidden={index !== 0}>
              {panel.items.length > 0 ? (
                <div class="entry-list">
                  {panel.items.map((item) => (
                    <button class="entry-row" type="button" data-load-type={panel.key} data-load-entry={item.id}>
                      <span><strong>{item.title}</strong><small>{item.meta}</small></span>
                      <span class="edit-mark">Load into workflow ↑</span>
                    </button>
                  ))}
                </div>
              ) : (
                <div class="empty-state">No entries yet. Select this content type and create the first one.</div>
              )}
            </div>
          ))}
        </section>

        <section class="commit-guide">
          <p><span>1</span> Prepare and copy here</p>
          <p><span>2</span> Open the GitHub editor</p>
          <p><span>3</span> Paste into the file area</p>
          <p><span>4</span> Commit changes</p>
        </section>
      </main>

      <footer class="admin-footer">
        <span>MIL content gateway</span>
        <a href={`${repositoryUrl}/tree/${branch}/src/content`} target="_blank" rel="noreferrer">Browse all source content ↗</a>
      </footer>
    </div>

    <script is:inline define:vars={{ adminData }}>
      window.__MIL_ADMIN_DATA__ = adminData;
    </script>
    <script is:inline src="bibtex.js"></script>
    <script is:inline src="admin.js"></script>
  </body>
</html>
