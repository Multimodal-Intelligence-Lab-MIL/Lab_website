---
import OptimizedImage from './OptimizedImage.astro';
interface Props { person: any; priority?: boolean }
const { person, priority = false } = Astro.props;
const data = person.data;
const initials = data.name
  .replace(/^(dr|prof(?:essor)?)\.?\s+/i, '')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part: string) => part[0])
  .join('')
  .toUpperCase();
---

<article class="person-card" data-glass="sheet" data-person data-category={data.category}>
  <div class:list={['person-photo', !data.image && 'person-photo-placeholder']}>
    {data.image ? (
      <OptimizedImage src={data.image} alt={`Portrait of ${data.name}`} width={224} widths={[112, 224]} sizes="(max-width: 600px) 88px, 112px" loading={priority ? 'eager' : 'lazy'} />
    ) : (
      <div role="img" aria-label={`No portrait is available for ${data.name}`}><span aria-hidden="true">{initials}</span></div>
    )}
  </div>
  <div class="person-card-body">
    <p class="person-category">{data.category}</p>
    <h3>{data.name}</h3>
    {data.role && <p class="person-role">{data.role}</p>}
    {data.bio && <p class="person-bio">{data.bio}</p>}
    <div class="person-links">
      {data.email && <a href={`mailto:${data.email}`}>Email</a>}
      {data.scholar && <a href={data.scholar} target="_blank" rel="noreferrer">Scholar</a>}
      {data.website && <a href={data.website} target="_blank" rel="noreferrer">Website</a>}
      {data.github && <a href={data.github} target="_blank" rel="noreferrer">GitHub</a>}
      {data.linkedin && <a href={data.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>}
    </div>
  </div>
</article>
