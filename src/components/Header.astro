---
import { sitePath } from '../lib/paths';
import OptimizedImage from './OptimizedImage.astro';

interface Props { currentPath?: string }
const { currentPath = '/' } = Astro.props;
const links = [
  ['Home', ''],
  ['People', 'people/'],
  ['Publications', 'publications/'],
  ['Research', 'research/'],
  ['Join us', 'join/']
];
const isActive = (path: string) => path === '' ? currentPath === '/' : currentPath.startsWith(`/${path}`);
---

<header class="site-header" data-glass="bar">
  <div class="shell nav-shell">
    <a class="brand" href={sitePath()} aria-label="Multimodal Intelligence Lab home">
      <OptimizedImage src="assets/images/mmi-lab-logo.jpg" alt="" width={84} widths={[42, 84]} sizes="42px" loading="eager" />
      <span><strong>MIL</strong><small>University of Exeter</small></span>
    </a>
    <button class="menu-button" type="button" aria-label="Open navigation" aria-expanded="false" data-menu-button>
      <span></span><span></span><span></span>
    </button>
    <nav aria-label="Primary navigation" data-menu>
      {links.map(([label, path]) => (
        <a href={sitePath(path)} data-astro-prefetch="load" aria-current={isActive(path) ? 'page' : undefined}>{label}</a>
      ))}
      <a class="nav-contact" href={sitePath('#contact')}>Contact</a>
    </nav>
  </div>
</header>
