---
const waveform = Array.from({ length: 35 }, (_, i) => 4 + Math.abs(Math.sin(i * 1.7) * Math.sin(i * .25)) * 49);
const terrain = Array.from({ length: 7 }, (_, row) => Array.from({ length: 18 }, (_, i) => {
  const height = Math.exp(-Math.pow((i - 8) / 4, 2)) * (29 - row * 2);
  return `${i * 6},${16 + row * 7 - height + Math.sin(i * .9 + row * .5) * 3}`;
}).join(' '));
---

<div class="multimodal-visual" data-neural-scene role="img" aria-label="A luminous three-dimensional neural core, gathering cyan image signals, violet language, rose audio and teal sensor data">
  <div class="core-aura" aria-hidden="true"></div>
  <svg class="signal-constellation" viewBox="0 0 640 640" fill="none" aria-hidden="true">
    <defs>
      <radialGradient id="core-fallback-fill" cx="35%" cy="28%" r="75%">
        <stop stop-color="#487b9a" /><stop offset=".45" stop-color="#173c60" /><stop offset="1" stop-color="#0b1d3c" />
      </radialGradient>
      <linearGradient id="orbit-spectrum" x1="0" x2="1" y1="0" y2="1">
        <stop stop-color="var(--signal-vision)" /><stop offset=".45" stop-color="var(--signal-language)" /><stop offset="1" stop-color="var(--signal-audio)" />
      </linearGradient>
    </defs>
    <g class="orbital-guides" stroke="url(#orbit-spectrum)" stroke-width=".65">
      <ellipse cx="320" cy="320" rx="242" ry="80" transform="rotate(-27 320 320)" />
      <ellipse cx="320" cy="320" rx="216" ry="175" transform="rotate(32 320 320)" stroke-dasharray="1 10" />
      <circle cx="320" cy="320" r="188" stroke-dasharray="48 215 1 18" />
    </g>
    <g class="orbital-rim" stroke="url(#orbit-spectrum)" stroke-width="1">
      <path d="M145 323A175 175 0 0 1 309 145M350 492A175 175 0 0 0 495 306" />
    </g>
    <g class="signal-source vision-source">
      <g transform="translate(47 115) rotate(-12 55 40)">
        <path class="signal-frame rear-frame" d="M14-12H114V58M7-6H107V64" />
        <rect class="signal-frame" width="110" height="77" rx="3" />
        <g transform="translate(4 22)" stroke="currentColor" stroke-width=".8">
          {terrain.map((points, i) => <polyline points={points} opacity={.35 + i * .08} />)}
        </g>
        <circle cx="83" cy="17" r="4" fill="currentColor" opacity=".65" />
        <path d="M0 13V0H13M97 77H110V64" stroke="currentColor" />
      </g>
      <path class="signal-trace" d="M145 199C196 206 204 244 242 263" />
      <path class="signal-pulse" d="M145 199C196 206 204 244 242 263" />
      <circle cx="166" cy="213" r="2.4" fill="currentColor" />
    </g>
    <g class="signal-source language-source">
      <g transform="translate(469 107) rotate(9 50 40)">
        <path class="signal-frame" d="M0 16V0H16M112 62V78H96" />
        <g fill="currentColor" font-family="ui-monospace, monospace">
          <text x="8" y="20" font-size="11" letter-spacing="3">A α 文 Ω</text>
          <text x="8" y="40" font-size="7.5" opacity=".8">The world in context</text>
          <text x="8" y="55" font-size="7.5" opacity=".6">meaning · connection</text>
        </g>
        <path d="M8 69H47M53 69H80" stroke="currentColor" stroke-width="1.3" opacity=".4" />
      </g>
      <path class="signal-trace" d="M480 191C422 203 430 246 398 268" />
      <path class="signal-pulse" d="M480 191C422 203 430 246 398 268" />
      <circle cx="459" cy="202" r="2.4" fill="currentColor" />
    </g>
    <g class="signal-source audio-source">
      <g transform="translate(471 442) rotate(8 62 30)">
        <path d="M0 31H128" stroke="currentColor" opacity=".17" />
        {waveform.map((height, i) => <line class="audio-bar" x1={5 + i * 3.4} x2={5 + i * 3.4} y1={31 - height / 2} y2={31 + height / 2} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" style={`--bar-delay: ${-i * .19}s`} />)}
        <path d="M10 70Q31 55 48 69T83 69T118 66" stroke="currentColor" stroke-width=".8" opacity=".4" />
      </g>
      <path class="signal-trace" d="M486 438C437 425 423 379 394 376" />
      <path class="signal-pulse" d="M486 438C437 425 423 379 394 376" />
      <circle cx="459" cy="424" r="2.4" fill="currentColor" />
    </g>
    <g class="signal-source sensor-source">
      <g transform="translate(45 434) rotate(-8 62 40)">
        <path d="M10 6V78H126M10 60H126M10 38H126M38 6V78M67 6V78M96 6V78" stroke="currentColor" stroke-width=".6" opacity=".16" />
        <path d="M11 48 28 48 36 35 43 59 52 22 62 65 71 42 89 43 100 28 107 51 117 39 126 41" stroke="currentColor" stroke-width="1.4" />
        {[0, 1, 2, 3, 4, 5, 6].map(i => <circle cx={17 + i * 16} cy={11 + Math.sin(i * 2) * 5} r="1.3" fill="currentColor" opacity=".6" />)}
      </g>
      <path class="signal-trace" d="M167 442C207 422 210 393 244 372" />
      <path class="signal-pulse" d="M167 442C207 422 210 393 244 372" />
      <circle cx="184" cy="430" r="2.4" fill="currentColor" />
    </g>
    <g class="core-fallback">
      <circle cx="320" cy="320" r="132" fill="url(#core-fallback-fill)" />
      {Array.from({ length: 9 }, (_, i) => <ellipse cx="320" cy="320" rx={20 + i * 14} ry="131" stroke="#7fd5e8" stroke-width=".6" opacity=".45" transform={`rotate(${i * 20} 320 320)`} />)}
    </g>
    <g fill="#638aa2" opacity=".35">
      <circle cx="249" cy="88" r="1.4" /><circle cx="559" cy="302" r="1.4" /><circle cx="338" cy="561" r="1.4" /><circle cx="92" cy="330" r="1.4" />
    </g>
  </svg>
  <canvas class="neural-canvas" aria-hidden="true"></canvas>
  <div class="core-ground" aria-hidden="true"></div>
</div>

<script>
  import { mountNeuralScene } from '../lib/neural-scene';
  document.querySelectorAll<HTMLElement>('[data-neural-scene]').forEach(mountNeuralScene);
</script>

<style>
  .multimodal-visual { position: relative; width: 112%; max-width: 680px; aspect-ratio: 1; justify-self: center; isolation: isolate; }
  .signal-constellation, .neural-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .neural-canvas { pointer-events: none; }
  .core-aura { position: absolute; inset: 14%; border-radius: 50%; background: conic-gradient(from 30deg, #8f87ee26, #cf77a91a, #70cdb726, #68c9e52e, #8f87ee26); filter: blur(38px); animation: aura-turn 50s linear infinite; }
  .core-ground { position: absolute; left: 30%; right: 30%; bottom: 14%; height: 3%; border-radius: 50%; background: #325979; opacity: .13; filter: blur(14px); }
  .orbital-guides { opacity: .24; }
  .orbital-rim { opacity: .4; transform-origin: 320px 320px; animation: aura-turn 100s linear infinite; }
  .signal-source { color: var(--signal-vision); }
  .language-source { color: var(--signal-language); }
  .audio-source { color: var(--signal-audio); }
  .sensor-source { color: var(--signal-sensor); }
  .signal-frame { fill: #ffffff66; stroke: currentColor; stroke-width: .65; stroke-opacity: .45; }
  .rear-frame { fill: none; opacity: .5; }
  .signal-trace { stroke: currentColor; stroke-width: .7; opacity: .23; }
  .signal-pulse { stroke: currentColor; stroke-width: 1.6; stroke-dasharray: 3 26; stroke-linecap: round; opacity: .68; animation: signal-transmission 7s linear infinite; }
  .language-source .signal-pulse { animation-delay: -1.7s; }
  .audio-source .signal-pulse { animation-delay: -3.5s; }
  .sensor-source .signal-pulse { animation-delay: -5.2s; }
  .audio-bar { transform-box: fill-box; transform-origin: center; animation: audio-breathe 4s ease-in-out var(--bar-delay) infinite; }
  [data-ready] .core-fallback { display: none; }
  [data-paused] *, [data-paused]::before { animation-play-state: paused !important; }
  @keyframes signal-transmission { to { stroke-dashoffset: -116; } }
  @keyframes aura-turn { to { transform: rotate(360deg); } }
  @keyframes audio-breathe { 50% { transform: scaleY(.45); opacity: .45; } }
  @media (max-width: 900px) { .multimodal-visual { width: 100%; max-width: 580px; margin-top: -1rem; } }
  @media (prefers-reduced-motion: reduce) { .core-aura, .orbital-rim, .signal-pulse, .audio-bar { animation: none; } }
</style>
