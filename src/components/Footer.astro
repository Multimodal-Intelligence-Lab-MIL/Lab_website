---
import site from '../data/site.json';
const year = new Date().getFullYear();
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.address)}`;
---

<footer class="site-footer" id="contact">
  <div class="shell footer-grid">
    <div>
      <p class="eyebrow">Multimodal Intelligence Lab</p>
      <h2><span>Many senses,</span> <span>one understanding.</span></h2>
    </div>
    <div class="footer-contact">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a class="footer-address" href={mapUrl} target="_blank" rel="noreferrer">{site.address.replace(/([A-Z]{1,2}\d[A-Z\d]?) (\d[A-Z]{2})/, '$1\u00a0$2')}</a>
    </div>
    <div class="footer-links" aria-label="Social links">
      <a href={site.github} target="_blank" rel="noreferrer">GitHub</a>
      <a href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      <a href={site.x} target="_blank" rel="noreferrer">X</a>
      <a href={site.youtube} target="_blank" rel="noreferrer">YouTube</a>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© {year} {site.name}</span>
    <span>Department of Computer Science · University of Exeter</span>
  </div>
</footer>
